# Copy to .env.local and fill in. Never commit real secrets.

# --- Public (inlined into client bundles) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# TravelBook booking-engine identifiers (same values the Angular app hardcodes).
NEXT_PUBLIC_BOOKING_HOTEL_ID=26609
NEXT_PUBLIC_BOOKING_STYLE_ID=20249
NEXT_PUBLIC_BOOKING_DC_ID=1161
# Cloudflare Turnstile site key. This is Cloudflare's published always-passes TEST key; use a real one in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Server only (secrets) ---
RESEND_API_KEY=re_replace_me
CONTACT_TO_EMAIL=inbox@example.com
# Must be on a domain verified in Resend, e.g. "Hotel Sapphire <no-reply@yourdomain.com>".
# For local dev only, Resend's sandbox sender is "onboarding@resend.dev".
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Cloudflare's published always-passes TEST secret; use the real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional: shared rate-limit store. If both are unset, an in-memory limiter is used (not reliable on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
